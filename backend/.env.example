# ─────────────────────────────────────────────────────────────────────────────
# Reliable LLM — backend configuration
# Copy to backend/.env and fill in AT LEAST ONE provider. Everything else has
# sensible defaults. Never commit .env (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# Providers are tried in this order; ones without a key are skipped. When the
# first is rate-limited for longer than LLM_MAX_WAIT_SECS, the next takes over.
LLM_PROVIDER_ORDER=ollama,gemini
# e.g. LLM_PROVIDER_ORDER=lmstudio,groq  to use LM Studio first

# ── Google Gemini (free) — https://aistudio.google.com/apikey ────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=5
GEMINI_FAST_RPM=10
GEMINI_THINKING_LEVEL=low

# ── Groq (free, fast, 30 req/min) — https://console.groq.com/keys ────────────
# Recommended as a second provider: it absorbs Gemini's tight free-tier limits.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── OpenRouter (free ":free" models) — https://openrouter.ai/keys ────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Ollama (local, no key, no limits) — https://ollama.com ───────────────────
# Install, `ollama pull qwen3:4b` (or any model), then set OLLAMA_ENABLED=true.
# OLLAMA_MODEL must match a NAME shown by `ollama list` exactly.
# ── Ollama (local) ──
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FAST_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false

# ── LM Studio (local, no key) — https://lmstudio.ai ─────────────────────────
# Start the server in LM Studio (Developer tab → Start server) or run
# `lms server start`. Model names must match `lms ls` exactly. LM Studio
# loads the model on first use (just-in-time loading).
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=meta-llama-3.1-8b-instruct
LMSTUDIO_FAST_MODEL=llama-3.2-3b-instruct

# ── Pipeline tuning (optional) ───────────────────────────────────────────────
# NUM_SAMPLES=2              # consistency re-samples in Thorough mode
# TOP_K=6                    # passages given to the model
# RERANK_ENABLED=true        # cross-encoder rerank (downloads ~90 MB once)
# CONFIDENCE_THRESHOLD=0.60
# LLM_MAX_WAIT_SECS=25
